# Report Integration Tool - environment template
#
# IMPORTANT:
# 1. Copy this file to .env before starting the backend.
# 2. Replace every CHANGE_ME value with a persistent secret/value.
# 3. NEVER commit .env or place real secrets in this file.
# 4. Keep SECRET_KEY and ENCRYPTION_KEY stable after the application
#    has been initialized with real users/connections.
#
# This template matches the configuration names currently used by the
# working backend. It intentionally does not change application code.

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------

APP_NAME=Integrated Report Management Tool
APP_VERSION=0.8.0

# Use "development" for local development or "production" for deployment.
APP_ENV=development

# In production this should normally be false.
APP_DEBUG=false

# Bind address for the FastAPI backend.
# 127.0.0.1 is safest for local development.
# Use 0.0.0.0 when the backend must be reachable from other machines/containers.
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------------------------------------------------------------------------
# AUTHENTICATION / APPLICATION SECRETS
# ---------------------------------------------------------------------------

# Persistent signing secret used by the existing authentication system.
# Generate with auth.generate_secret_key() or a secret manager.
# Production requires at least 32 characters.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Persistent Fernet key used by the existing credential-encryption system.
# Generate with security.generate_encryption_key() or a secret manager.
# Do NOT replace it until the documented rotation workflow is used.
ENCRYPTION_KEY=CHANGE_ME_TO_A_VALID_FERNET_KEY

AUTH_PBKDF2_ITERATIONS=600000
AUTH_TOKEN_EXPIRE_SECONDS=3600

# ---------------------------------------------------------------------------
# FRONTEND / CORS
# ---------------------------------------------------------------------------

# Comma-separated frontend origins.
# Local Vite development commonly uses both of these.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Existing production-security setting.
# Keep true only when the frontend authentication workflow requires credentials.
CORS_ALLOW_CREDENTIALS=true

# Existing production-security setting.
# Automatically defaults to true in production; explicitly setting it here
# makes the deployment behavior easier to understand.
SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# DATA / METADATA FILES
# ---------------------------------------------------------------------------

# Keep the existing JSON-backed data location unless a different persistent
# location is intentionally configured.
DATA_DIR=./data

# Optional explicit saved-report file. Leave this as the normal data location
# unless the deployment needs a separate path.
REPORTS_FILE=./data/saved_reports.json

# ---------------------------------------------------------------------------
# QUERY ENGINE
# ---------------------------------------------------------------------------

# 0 means no artificial report-row ceiling.
MAX_QUERY_ROWS=0

QUERY_TIMEOUT_SECONDS=0
QUERY_CHUNK_SIZE=5000
QUERY_PUSHDOWN_ENABLED=true

# ---------------------------------------------------------------------------
# REPORT EXECUTION / RESOURCE PROTECTION
# ---------------------------------------------------------------------------

# 0 = automatically size concurrent report slots from available CPU/container memory
MAX_CONCURRENT_REPORTS=0
# 0 = automatically size the execution worker pool; set explicitly when required
EXECUTION_WORKERS=0
REPORT_RESOURCE_WAIT_SECONDS=30
REPORT_JOB_RETENTION_SECONDS=3600

# ---------------------------------------------------------------------------
# RESULT / JOIN LIMITS
# ---------------------------------------------------------------------------

MAX_EXPORT_FILE_MB=0
MAX_JOIN_MEMORY_MB=1024

MAX_REQUEST_BODY_MB=0
MAX_JOIN_OPERATIONS=0

MAX_PREVIEW_ROWS=0
MAX_VISUALIZATION_ROWS=0
MAX_JOIN_DATASETS=0

# ---------------------------------------------------------------------------
# BACKUP
# ---------------------------------------------------------------------------

BACKUP_RETENTION_COUNT=10

# Optional external backup directory.
# Leave empty to use the application's normal backup behavior.
BACKUP_EXTERNAL_DIR=

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# FRONTEND BUILD-TIME CONFIGURATION
# ---------------------------------------------------------------------------
#
# This variable belongs to the frontend .env / Vite environment, NOT the
# backend .env. It is documented here only so the complete deployment
# configuration is visible in one place.
#
# Current frontend fallback remains:
#   http://127.0.0.1:8000
#
# For the current baseline, do not change frontend authentication behavior
# as part of this configuration cleanup.
#
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# KEY ROTATION (OPTIONAL TRANSITION SETTINGS)
# ---------------------------------------------------------------------------
# During rotation only, place the OLD key here while the new key is active.
# The application uses *_PREVIOUS for verification/decryption only; new
# tokens and newly saved credentials always use the active key.
# Remove these values after migration and the transition window ends.
SECRET_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS=

# Safe rotation workflow:
# 1. Back up the persistent data directory.
# 2. Generate new keys using a secure secret manager or the existing
#    security.generate_encryption_key() helper for ENCRYPTION_KEY.
# 3. Set new keys as SECRET_KEY / ENCRYPTION_KEY and old keys as *_PREVIOUS.
# 4. Restart the backend and run: python rotate_keys.py --encryption
# 5. Verify saved database connections and authentication.
# 6. Remove *_PREVIOUS and restart again.
# Never print or commit real key values.
