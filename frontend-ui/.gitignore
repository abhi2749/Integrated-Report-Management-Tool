# ============================================================
# Reporting Tool - Frontend .gitignore
# ============================================================

# Dependencies
node_modules/

# Build output
dist/
build/
.vite/

# Local environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.cache
